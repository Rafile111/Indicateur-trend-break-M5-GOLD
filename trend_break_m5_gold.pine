//@version=6
// =============================================================================
//  Trend Break - M5 GOLD (XAUUSD)
//  Indicateur de cassure de tendance pensé pour l'or en unité de temps M5.
//
//  Logique :
//    - Swing = 3 bougies (1 de chaque côté du pivot central).
//    - Leg = mouvement entre deux swings opposés ; on ne retient que son EXTRÊME
//      (zigzag), ce qui élimine les petits swings internes non significatifs.
//    - BoS (Break of Structure) haussier : clôture au-dessus de l'extrême haut de leg.
//    - BoS baissier : clôture sous l'extrême bas de leg.
//    - Tendance CONFIRMÉE après 3 BoS consécutifs du même type (un BoS opposé
//      remet le compteur à zéro pendant cette phase de construction).
//    - Une fois la tendance confirmée, une SEULE cassure opposée suffit à
//      provoquer un CHANGEMENT de tendance (CHoCH) : la tendance bascule.
// =============================================================================
indicator(title = "Trend Break M5 GOLD", shorttitle = "TB M5 GOLD", overlay = true, max_lines_count = 500)

// =============================================================================
//  PARAMÈTRES (inputs)
// =============================================================================
grpStruct = "Détection de structure"
// Swing = 3 bougies : 1 bougie de chaque côté du sommet/creux central.
swingLen  = input.int(1, title = "Bougies de chaque côté du swing", minval = 1, group = grpStruct, tooltip = "1 = swing de 3 bougies (1 à gauche, le pivot, 1 à droite). Augmente pour ne garder que des swings plus marqués.")
confBos   = input.int(3, title = "BoS consécutifs pour confirmer", minval = 2, group = grpStruct, tooltip = "Nombre de cassures de structure consécutives nécessaires pour confirmer une nouvelle tendance de départ.")

grpVisu  = "Affichage"
showBos   = input.bool(true, title = "Afficher les BoS",            group = grpVisu)
showTrend = input.bool(true, title = "Afficher confirmations / changements", group = grpVisu)
showLines = input.bool(true, title = "Tracer les lignes de structure (BoS)", group = grpVisu, tooltip = "Trace une ligne horizontale depuis chaque swing ; elle s'arrête là où le prix vient la toucher.")
bullCol  = input.color(color.new(color.green, 0), title = "Couleur haussière", group = grpVisu)
bearCol  = input.color(color.new(color.red, 0),   title = "Couleur baissière", group = grpVisu)

grpAlert = "Alertes"
useAlert = input.bool(true, title = "Activer les alertes", group = grpAlert)

// =============================================================================
//  DÉTECTION DES SWINGS ET CONSTRUCTION DES LEGS (zigzag)
// =============================================================================
// pivothigh/pivotlow renvoient une valeur confirmée 'swingLen' bougies plus tard.
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low,  swingLen, swingLen)
pivotBar = bar_index - swingLen   // bougie réelle du pivot

// Zigzag : on ne conserve que l'EXTRÊME de chaque leg (structure pure).
//   zdir  = type du dernier swing validé (+1 = high, -1 = low)
//   zHigh = sommet de la dernière leg montante   (référence d'un BoS haussier)
//   zLow  = creux  de la dernière leg descendante (référence d'un BoS baissier)
var int   zdir  = 0
var float zHigh = na
var float zLow  = na

bool newHigh = false   // nouvel extrême haut de leg (créé ou rehaussé)
bool newLow  = false   // nouvel extrême bas de leg  (créé ou abaissé)

if not na(ph)
    if zdir == 1
        // Toujours dans la même leg montante : on ne garde que le point le plus haut.
        if ph > zHigh
            zHigh   := ph
            newHigh := true
    else
        // La leg descendante se termine, une leg montante commence.
        zHigh   := ph
        zdir    := 1
        newHigh := true
if not na(pl)
    if zdir == -1
        // Toujours dans la même leg descendante : on ne garde que le point le plus bas.
        if pl < zLow
            zLow   := pl
            newLow := true
    else
        zLow   := pl
        zdir   := -1
        newLow := true

// Références de cassure = extrêmes de leg courants (et non plus les mini-pivots).
lastHigh = zHigh
lastLow  = zLow

// =============================================================================
//  LIGNES DE STRUCTURE
// =============================================================================
// Une ligne part de l'extrême de leg et se prolonge tant que le prix ne l'a pas
// touchée ; une fois touchée, elle est figée et passée en trait plein.
var line hiLine    = na
var bool hiTouched = false
var line loLine    = na
var bool loTouched = false

if newHigh and showLines
    hiLine    := line.new(pivotBar, zHigh, bar_index, zHigh, color = color.new(bearCol, 20), width = 1, style = line.style_dashed)
    hiTouched := false
if newLow and showLines
    loLine    := line.new(pivotBar, zLow, bar_index, zLow, color = color.new(bullCol, 20), width = 1, style = line.style_dashed)
    loTouched := false

// Prolongation jusqu'au contact, puis figée et passée en trait plein.
if not na(hiLine) and not hiTouched
    line.set_x2(hiLine, bar_index)
    if high >= line.get_y1(hiLine)
        line.set_style(hiLine, line.style_solid)
        line.set_color(hiLine, color.new(bullCol, 0))
        hiTouched := true
if not na(loLine) and not loTouched
    line.set_x2(loLine, bar_index)
    if low <= line.get_y1(loLine)
        line.set_style(loLine, line.style_solid)
        line.set_color(loLine, color.new(bearCol, 0))
        loTouched := true

// =============================================================================
//  CASSURE DE STRUCTURE (BoS)
// =============================================================================
// crossover/crossunder ne se déclenchent qu'une fois par franchissement : un
// nouveau BoS du même type exige donc qu'un nouveau swing se soit formé.
breakUp   = not na(lastHigh) and ta.crossover(close, lastHigh)
breakDown = not na(lastLow)  and ta.crossunder(close, lastLow)

// =============================================================================
//  MACHINE À ÉTATS : construction de tendance puis changement (CHoCH)
// =============================================================================
var int trend   = 0   // tendance confirmée : +1 haussière, -1 baissière, 0 aucune
var int upCount = 0   // BoS haussiers consécutifs (phase de construction)
var int dnCount = 0   // BoS baissiers consécutifs (phase de construction)

// Événements émis sur la bougie courante.
bool confirmUp   = false   // tendance haussière confirmée (3 BoS)
bool confirmDown = false   // tendance baissière confirmée (3 BoS)
bool changeUp    = false   // changement de tendance vers le haussier (CHoCH)
bool changeDown  = false   // changement de tendance vers le baissier (CHoCH)

if breakUp
    if trend == 1
        // Continuation de la tendance haussière déjà confirmée : rien à signaler.
        upCount := 0
        dnCount := 0
    else if trend == -1
        // Cassure opposée après une tendance baissière confirmée => CHoCH.
        trend     := 1
        changeUp  := true
        upCount   := 0
        dnCount   := 0
    else
        // Phase de construction : on compte les BoS haussiers consécutifs.
        upCount += 1
        dnCount := 0
        if upCount >= confBos
            trend     := 1
            confirmUp := true
            upCount   := 0

if breakDown
    if trend == -1
        upCount := 0
        dnCount := 0
    else if trend == 1
        trend      := -1
        changeDown := true
        upCount    := 0
        dnCount    := 0
    else
        dnCount += 1
        upCount := 0
        if dnCount >= confBos
            trend       := -1
            confirmDown := true
            dnCount     := 0

// =============================================================================
//  AFFICHAGE
// =============================================================================
// BoS « bruts » (petits triangles).
plotshape(showBos and breakUp   and not confirmUp   and not changeUp,   title = "BoS haussier", style = shape.triangleup,   location = location.belowbar, color = color.new(bullCol, 35), size = size.tiny)
plotshape(showBos and breakDown and not confirmDown and not changeDown, title = "BoS baissier", style = shape.triangledown, location = location.abovebar, color = color.new(bearCol, 35), size = size.tiny)

// Confirmations de tendance (3 BoS).
plotshape(showTrend and confirmUp,   title = "Tendance haussière confirmée", style = shape.labelup,   location = location.belowbar, color = bullCol, textcolor = color.white, text = "TREND ▲", size = size.small)
plotshape(showTrend and confirmDown, title = "Tendance baissière confirmée", style = shape.labeldown, location = location.abovebar, color = bearCol, textcolor = color.white, text = "TREND ▼", size = size.small)

// Changements de tendance (CHoCH, 1 cassure opposée).
plotshape(showTrend and changeUp,   title = "Changement vers haussier", style = shape.labelup,   location = location.belowbar, color = bullCol, textcolor = color.white, text = "CHoCH ▲", size = size.small)
plotshape(showTrend and changeDown, title = "Changement vers baissier", style = shape.labeldown, location = location.abovebar, color = bearCol, textcolor = color.white, text = "CHoCH ▼", size = size.small)

// =============================================================================
//  ALERTES
// =============================================================================
alertcondition(confirmUp,   title = "Tendance haussière confirmée", message = "Trend Break M5 GOLD : tendance HAUSSIÈRE confirmée")
alertcondition(confirmDown, title = "Tendance baissière confirmée", message = "Trend Break M5 GOLD : tendance BAISSIÈRE confirmée")
alertcondition(changeUp,    title = "Changement vers haussier",     message = "Trend Break M5 GOLD : CHANGEMENT de tendance vers le HAUSSIER")
alertcondition(changeDown,  title = "Changement vers baissier",     message = "Trend Break M5 GOLD : CHANGEMENT de tendance vers le BAISSIER")

if useAlert and (confirmUp or changeUp)
    alert("Trend Break M5 GOLD : signal HAUSSIER (" + (confirmUp ? "tendance confirmée" : "changement de tendance") + ")", alert.freq_once_per_bar_close)
if useAlert and (confirmDown or changeDown)
    alert("Trend Break M5 GOLD : signal BAISSIER (" + (confirmDown ? "tendance confirmée" : "changement de tendance") + ")", alert.freq_once_per_bar_close)
